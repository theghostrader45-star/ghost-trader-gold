<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>XAU/USD Pro | Backtester & Bitácora Real</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            gold: {
              400: '#FACC15',
              500: '#EAB308',
              600: '#CA8A04',
            },
            tvBlue: '#2962FF',
            tvGreen: '#089981',
            tvRed: '#F23645',
            darkBg: '#090D16',
            cardBg: '#111827',
            cardBorder: '#1F2937'
          }
        }
      }
    }
  </script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="stylesheet" href="styles.css">
</head>
<body class="bg-darkBg text-slate-100 min-h-screen font-sans antialiased selection:bg-gold-500 selection:text-black">

  <!-- Header / Top Bar -->
  <header class="border-b border-gray-800 bg-gray-900/90 backdrop-blur sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3.5 flex flex-wrap items-center justify-between gap-4">
      
      <!-- Brand & Mode Badge -->
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 via-yellow-500 to-gold-400 flex items-center justify-center text-black font-black shadow-lg shadow-gold-500/20">
          <i data-lucide="trending-up" class="w-6 h-6 stroke-[2.5]"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-base sm:text-lg font-bold tracking-tight text-white flex items-center gap-2">
              XAU/USD Pro Dashboard
              <span class="text-xs bg-gold-500/15 text-gold-400 border border-gold-500/30 px-2 py-0.5 rounded-full font-semibold flex items-center gap-1 font-mono">
                <i data-lucide="check" class="w-3 h-3 text-gold-400"></i> Puro Porcentaje & Puntos
              </span>
            </h1>
          </div>
          <p class="text-xs text-gray-400">Backtesting Dinámico • Bitácora Real • Calculadora Myfxbook</p>
        </div>
      </div>

      <!-- Quick Badges -->
      <div class="hidden md:flex items-center gap-2 text-xs">
        <div class="bg-gray-800/80 border border-gray-700/60 px-3 py-1.5 rounded-lg flex items-center gap-2">
          <span class="text-gray-400">Capital Base:</span>
          <span class="font-bold text-emerald-400">$<span id="badgeInitialBalance">110.00</span></span>
        </div>
        <div class="bg-emerald-950/50 border border-emerald-800/50 px-3 py-1.5 rounded-lg flex items-center gap-2">
          <span class="text-emerald-300">Riesgo %:</span>
          <span class="font-bold text-emerald-400"><span id="badgeRiskPct">5.0</span>% (<span id="badgeCurrentRiskUsd">$5.50</span>)</span>
        </div>
        <div class="bg-blue-950/50 border border-blue-800/50 px-3 py-1.5 rounded-lg flex items-center gap-2">
          <span class="text-blue-300">Ratio R:R:</span>
          <span class="font-bold text-blue-400">1:<span id="badgeCurrentRR">1.0</span></span>
        </div>
        <div class="bg-purple-950/50 border border-purple-800/50 px-3 py-1.5 rounded-lg flex items-center gap-2">
          <span class="text-purple-300">Apal.:</span>
          <span class="font-bold text-purple-400">1:300</span>
        </div>
      </div>

      <!-- Actions: Limpiar Todo & Config -->
      <div class="flex items-center gap-2">
        <button id="btnClearData" class="px-3 py-1.5 bg-red-950/50 hover:bg-red-900/80 text-xs font-semibold rounded-lg border border-red-800/60 transition flex items-center gap-1.5 text-red-200" title="Reiniciar datos de la vista activa">
          <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
          <span>Limpiar</span>
        </button>
        <button id="btnOpenSettings" class="px-3 py-1.5 bg-gray-800 hover:bg-gray-700 text-xs font-medium rounded-lg border border-gray-700 text-gray-300 transition flex items-center gap-1.5" title="Configuración de Cuenta">
          <i data-lucide="settings" class="w-3.5 h-3.5"></i>
          <span>Ajustes</span>
        </button>
      </div>

    </div>
  </header>

  <!-- Main Container -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6 space-y-6">

    <!-- NAVIGATION TABS: Backtesting / Bitácora Real / Calculadora Myfxbook -->
    <nav class="flex flex-wrap items-center gap-2 p-1 bg-gray-900/90 rounded-2xl border border-gray-800 shadow-xl">
      <!-- Tab 1: Backtesting -->
      <button id="tabBtnBacktest" class="tab-button flex-1 min-w-[140px] px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold flex items-center justify-center gap-2 transition bg-blue-600 text-white shadow-lg shadow-blue-600/30">
        <i data-lucide="bar-chart-2" class="w-4 h-4"></i>
        <span>1. Backtesting</span>
        <span id="tabBadgeBacktest" class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-blue-900/80 text-blue-200 border border-blue-400/30">37 ops</span>
      </button>

      <!-- Tab 2: Bitácora Real -->
      <button id="tabBtnRealJournal" class="tab-button flex-1 min-w-[140px] px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold flex items-center justify-center gap-2 transition text-gray-400 hover:text-white hover:bg-gray-800/60">
        <i data-lucide="book-open" class="w-4 h-4 text-emerald-400"></i>
        <span>2. Bitácora Real</span>
        <span id="tabBadgeReal" class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-gray-800 text-emerald-400 border border-gray-700">0 ops</span>
      </button>

      <!-- Tab 3: Calculadora Myfxbook -->
      <button id="tabBtnCalculator" class="tab-button flex-1 min-w-[140px] px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold flex items-center justify-center gap-2 transition text-gray-400 hover:text-white hover:bg-gray-800/60">
        <i data-lucide="calculator" class="w-4 h-4 text-amber-400"></i>
        <span>3. Calculadora Myfxbook</span>
        <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-amber-950 text-amber-300 border border-amber-800">Oro XAU</span>
      </button>

      <!-- Tab 4: Macro Sesión Oro -->
      <button id="tabBtnGoldBias" class="tab-button flex-1 min-w-[140px] px-4 py-2.5 rounded-xl text-xs sm:text-sm font-semibold flex items-center justify-center gap-2 transition text-gray-400 hover:text-white hover:bg-gray-800/60">
        <i data-lucide="compass" class="w-4 h-4 text-yellow-400"></i>
        <span>4. Macro Sesión Oro (XAU)</span>
        <span id="tabBadgeBias" class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-red-950 text-red-300 border border-red-800">BAJISTA 85%</span>
      </button>
    </nav>


    <!-- ============================================================== -->
    <!-- VIEW 1: BACKTESTING (Recálculo Dinámico sin Borrar Trades)     -->
    <!-- ============================================================== -->
    <div id="viewBacktest" class="space-y-6">

      <!-- Dynamic Parameter Recalculation Console -->
      <section class="bg-gradient-to-r from-blue-950/40 via-gray-900 to-indigo-950/40 border-2 border-blue-500/40 rounded-2xl p-4 sm:p-5 shadow-2xl space-y-3">
        
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-800 pb-3">
          <div class="flex items-center gap-2.5">
            <div class="p-2 bg-blue-500/20 text-blue-400 rounded-xl border border-blue-500/30">
              <i data-lucide="sliders-horizontal" class="w-5 h-5"></i>
            </div>
            <div>
              <h2 class="text-sm sm:text-base font-bold text-white flex items-center gap-2">
                <span>Recálculo en Vivo de Backtest</span>
                <span class="text-[10px] bg-emerald-950 text-emerald-400 border border-emerald-800 px-2 py-0.5 rounded-full font-mono">Conserva tus operaciones</span>
              </h2>
              <p class="text-xs text-gray-400">Modifica el <strong>Saldo Inicial</strong>, <strong>% de Riesgo</strong> o <strong>R:R</strong> instantáneamente sobre tus trades registrados</p>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div class="text-xs text-gray-400 flex items-center gap-1.5">
              <i data-lucide="crosshair" class="w-3.5 h-3.5 text-blue-400"></i>
              <span>SL Promedio:</span>
              <span class="px-2 py-0.5 rounded-md bg-blue-950/80 border border-blue-800/60 font-bold text-blue-300 font-mono" id="recalcAvgSlBadge">0 pts ($0.00)</span>
            </div>
            <div class="text-xs text-gray-400 flex items-center gap-1.5">
              <span>Trades:</span>
              <span class="px-2 py-0.5 rounded-md bg-gray-800 font-bold text-white font-mono" id="recalcTradesCount">0</span>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-3.5 pt-1">
          
          <!-- Control 1: Saldo Inicial ($ USD) -->
          <div class="bg-gray-950/80 p-3 rounded-xl border border-gray-800 space-y-2">
            <div class="flex items-center justify-between">
              <label class="text-xs font-bold text-gray-200 flex items-center gap-1.5">
                <i data-lucide="wallet" class="w-3.5 h-3.5 text-emerald-400"></i>
                <span>Saldo Inicial de Cuenta</span>
              </label>
              <span class="text-xs font-mono font-bold text-emerald-400" id="labelActiveInitialBal">$110.00</span>
            </div>

            <div class="flex items-center gap-2">
              <div class="relative flex-1">
                <span class="absolute left-3 top-2 text-xs text-gray-500 font-bold">$</span>
                <input type="number" id="globalInitialInput" step="10" min="10" max="1000000" class="w-full bg-gray-900 border border-gray-700 rounded-lg pl-7 pr-3 py-1.5 text-white font-mono font-bold text-sm focus:border-blue-500 focus:outline-none" value="110">
              </div>
              
              <!-- Quick Initial Buttons -->
              <div class="flex items-center gap-1">
                <button type="button" class="btnQuickInitial px-2 py-1 bg-blue-600/30 text-blue-400 border border-blue-500/50 rounded text-xs font-mono font-bold" data-initial="110">$110</button>
                <button type="button" class="btnQuickInitial px-2 py-1 bg-gray-800 hover:bg-gray-700 rounded text-xs font-mono text-gray-300" data-initial="500">$500</button>
                <button type="button" class="btnQuickInitial px-2 py-1 bg-gray-800 hover:bg-gray-700 rounded text-xs font-mono text-gray-300" data-initial="1000">$1k</button>
                <button type="button" class="btnQuickInitial px-2 py-1 bg-gray-800 hover:bg-gray-700 rounded text-xs font-mono text-gray-300" data-initial="5000">$5k</button>
              </div>
            </div>
          </div>

          <!-- Control 2: Porcentaje de Riesgo (%) -->
          <div class="bg-gray-950/80 p-3 rounded-xl border border-gray-800 space-y-2">
            <div class="flex items-center justify-between">
              <label class="text-xs font-bold text-gray-200 flex items-center gap-1.5">
                <i data-lucide="shield-alert" class="w-3.5 h-3.5 text-amber-400"></i>
                <span>Riesgo Compuesto por Operación</span>
              </label>
              <span class="text-xs font-mono font-bold text-amber-400" id="labelActiveRiskPct">5.0%</span>
            </div>

            <div class="flex items-center gap-2">
              <div class="relative flex-1">
                <input type="number" id="globalRiskInput" step="0.1" min="0.5" max="30" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-3 py-1.5 text-white font-mono font-bold text-sm focus:border-blue-500 focus:outline-none" value="5.0">
                <span class="absolute right-3 top-2 text-xs text-gray-500 font-bold">%</span>
              </div>
              
              <!-- Quick Risk Buttons -->
              <div class="flex items-center gap-1">
                <button type="button" class="btnQuickRisk px-2 py-1 bg-gray-800 hover:bg-gray-700 rounded text-xs font-mono text-gray-300" data-risk="1.0">1%</button>
                <button type="button" class="btnQuickRisk px-2 py-1 bg-gray-800 hover:bg-gray-700 rounded text-xs font-mono text-gray-300" data-risk="2.0">2%</button>
                <button type="button" class="btnQuickRisk px-2 py-1 bg-gray-800 hover:bg-gray-700 rounded text-xs font-mono text-gray-300" data-risk="3.0">3%</button>
                <button type="button" class="btnQuickRisk px-2 py-1 bg-blue-600/30 text-blue-400 border border-blue-500/50 rounded text-xs font-mono font-bold" data-risk="5.0">5%</button>
                <button type="button" class="btnQuickRisk px-2 py-1 bg-gray-800 hover:bg-gray-700 rounded text-xs font-mono text-gray-300" data-risk="10.0">10%</button>
              </div>
            </div>
          </div>

          <!-- Control 3: Ratio Riesgo / Beneficio (R:R) -->
          <div class="bg-gray-950/80 p-3 rounded-xl border border-gray-800 space-y-2">
            <div class="flex items-center justify-between">
              <label class="text-xs font-bold text-gray-200 flex items-center gap-1.5">
                <i data-lucide="scale" class="w-3.5 h-3.5 text-blue-400"></i>
                <span>Ratio Riesgo / Beneficio (R:R)</span>
              </label>
              <span class="text-xs font-mono font-bold text-blue-400" id="labelActiveRR">1:1.0</span>
            </div>

            <div class="flex items-center gap-2">
              <div class="relative flex-1">
                <div class="absolute left-3 top-2 text-xs text-gray-500 font-bold">1:</div>
                <input type="number" id="globalRRInput" step="0.1" min="0.5" max="10" class="w-full bg-gray-900 border border-gray-700 rounded-lg pl-7 pr-3 py-1.5 text-white font-mono font-bold text-sm focus:border-blue-500 focus:outline-none" value="1.0">
              </div>
              
              <!-- Quick RR Buttons -->
              <div class="flex items-center gap-1">
                <button type="button" class="btnQuickRR px-2 py-1 bg-blue-600/30 text-blue-400 border border-blue-500/50 rounded text-xs font-mono font-bold" data-rr="1.0">1:1</button>
                <button type="button" class="btnQuickRR px-2 py-1 bg-gray-800 hover:bg-gray-700 rounded text-xs font-mono text-gray-300" data-rr="1.5">1:1.5</button>
                <button type="button" class="btnQuickRR px-2 py-1 bg-gray-800 hover:bg-gray-700 rounded text-xs font-mono text-gray-300" data-rr="2.0">1:2</button>
                <button type="button" class="btnQuickRR px-2 py-1 bg-gray-800 hover:bg-gray-700 rounded text-xs font-mono text-gray-300" data-rr="3.0">1:3</button>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- KPI Summary Cards (Backtest) -->
      <section class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-7 gap-3.5">
        
        <!-- Card 1: Win Rate -->
        <div class="bg-cardBg border border-cardBorder rounded-xl p-4 flex flex-col justify-between relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">Efectividad</span>
            <span id="winRateBadge" class="text-[10px] px-1.5 py-0.5 rounded font-bold bg-gray-800 text-gray-400">0 Trades</span>
          </div>
          <div class="mt-2">
            <div class="text-2xl font-black text-white" id="statWinRate">0.0%</div>
            <div class="text-[11px] text-gray-400 flex items-center justify-between mt-1">
              <span><strong id="statWins" class="text-emerald-400">0</strong> Wins</span>
              <span><strong id="statLosses" class="text-rose-400">0</strong> Losses</span>
            </div>
          </div>
          <div class="w-full bg-gray-800 h-1.5 rounded-full mt-2.5 overflow-hidden">
            <div id="statWinRateBar" class="bg-gradient-to-r from-amber-500 to-emerald-400 h-full rounded-full transition-all duration-500" style="width: 0%"></div>
          </div>
        </div>

        <!-- Card 2: Balance Actual & PnL Compuesto -->
        <div class="bg-cardBg border border-cardBorder rounded-xl p-4 flex flex-col justify-between relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">Balance Compuesto</span>
            <span id="statReturnBadge" class="text-[10px] px-1.5 py-0.5 rounded font-bold bg-gray-800 text-gray-400">0.0%</span>
          </div>
          <div class="mt-2">
            <div class="text-2xl font-black text-white" id="statCurrentBalance">$110.00</div>
            <div class="text-[11px] mt-1 text-gray-400">
              PnL: <span id="statNetPnL" class="font-bold text-gray-300">$0.00</span>
            </div>
          </div>
          <div class="text-[10px] text-gray-500 mt-2">
            Inicio: $<span id="statInitialLabel">110.00</span> USD
          </div>
        </div>

        <!-- Card 3: Profit Factor -->
        <div class="bg-cardBg border border-cardBorder rounded-xl p-4 flex flex-col justify-between relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">Profit Factor</span>
            <i data-lucide="scale" class="w-3.5 h-3.5 text-gray-500"></i>
          </div>
          <div class="mt-2">
            <div class="text-2xl font-black text-white" id="statProfitFactor">0.00</div>
            <div class="text-[11px] text-gray-400 mt-1 flex justify-between">
              <span class="text-emerald-400/90">+$<span id="statTotalGain">0.00</span></span>
              <span class="text-rose-400/90">-$<span id="statTotalLoss">0.00</span></span>
            </div>
          </div>
          <div class="text-[10px] text-gray-500 mt-2" id="breakevenTargetText">
            BE objetivo: 50.0%
          </div>
        </div>

        <!-- Card 4: Max Drawdown -->
        <div class="bg-cardBg border border-cardBorder rounded-xl p-4 flex flex-col justify-between relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">Max Drawdown</span>
            <i data-lucide="trending-down" class="w-3.5 h-3.5 text-rose-500"></i>
          </div>
          <div class="mt-2">
            <div class="text-2xl font-black text-rose-400" id="statMaxDD">0.0%</div>
            <div class="text-[11px] text-gray-400 mt-1">
              Caída: <span id="statMaxDDUsd" class="font-semibold text-gray-300">-$0.00</span>
            </div>
          </div>
          <div class="text-[10px] text-gray-500 mt-2">
            Puro interés compuesto
          </div>
        </div>

        <!-- Card 5: Rachas -->
        <div class="bg-cardBg border border-cardBorder rounded-xl p-4 flex flex-col justify-between relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">Rachas Consec.</span>
            <i data-lucide="flame" class="w-3.5 h-3.5 text-amber-500"></i>
          </div>
          <div class="mt-2">
            <div class="flex items-baseline gap-2">
              <span class="text-2xl font-black text-emerald-400" id="statMaxWinStreak">0</span>
              <span class="text-xs text-gray-400">Wins</span>
              <span class="text-gray-600">/</span>
              <span class="text-2xl font-black text-rose-400" id="statMaxLossStreak">0</span>
              <span class="text-xs text-gray-400">Loss</span>
            </div>
            <div class="text-[11px] text-gray-400 mt-1">
              Racha de pérdidas máx
            </div>
          </div>
          <div class="text-[10px] text-gray-500 mt-2">
            Riesgo controlado
          </div>
        </div>

        <!-- Card 6: Expectativa -->
        <div class="bg-cardBg border border-cardBorder rounded-xl p-4 flex flex-col justify-between relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">Expectativa</span>
            <i data-lucide="coins" class="w-3.5 h-3.5 text-gold-400"></i>
          </div>
          <div class="mt-2">
            <div class="text-2xl font-black text-white" id="statExpectancy">$0.00</div>
            <div class="text-[11px] text-gray-400 mt-1">
              Ganancia media / trade
            </div>
          </div>
          <div class="text-[10px] text-gray-500 mt-2">
            Total trades: <span id="statTotalTrades" class="font-bold text-gray-300">0</span>
          </div>
        </div>

        <!-- Card 7: SL Promedio Registrado -->
        <div class="bg-cardBg border border-cardBorder rounded-xl p-4 flex flex-col justify-between relative overflow-hidden">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">SL Promedio</span>
            <i data-lucide="crosshair" class="w-3.5 h-3.5 text-blue-400"></i>
          </div>
          <div class="mt-2">
            <div class="text-2xl font-black text-white flex items-baseline gap-1">
              <span id="statAvgSlPoints">0</span>
              <span class="text-xs text-blue-400 font-mono font-bold">pts</span>
            </div>
            <div class="text-[11px] text-gray-400 mt-1">
              Precio: $<span id="statAvgSlPrice" class="font-semibold text-gray-300">0.00</span>
            </div>
          </div>
          <div class="text-[10px] text-gray-500 mt-2 flex items-center justify-between">
            <span>Rango:</span>
            <span id="statMinMaxSl" class="font-mono text-gray-400 font-semibold">-</span>
          </div>
        </div>

      </section>

      <!-- REGISTRAR OPERACIÓN AL BACKTEST -->
      <section class="bg-gradient-to-b from-gray-900 to-cardBg border border-cardBorder rounded-2xl p-5 sm:p-6 shadow-2xl space-y-4">
        
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-800 pb-4">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-blue-500/15 border border-blue-500/30 flex items-center justify-center text-blue-400">
              <i data-lucide="crosshair" class="w-5 h-5"></i>
            </div>
            <div>
              <h2 class="text-base font-bold text-white flex items-center gap-2">
                <span>Registrar Nueva Operación de Backtest</span>
              </h2>
              <p class="text-xs text-gray-400">
                Ingresa los puntos de Stop Loss en el Oro (ej. 250 pts = $2.50) y el resultado obtenido
              </p>
            </div>
          </div>

          <div class="flex items-center gap-2 text-xs bg-emerald-950/50 border border-emerald-800/50 px-3 py-1.5 rounded-xl">
            <span class="text-gray-400">Capital para este trade:</span>
            <span class="font-mono font-bold text-emerald-400 text-sm" id="formCurrentBalanceDisplay">$110.00</span>
            <span class="text-gray-500">|</span>
            <span class="text-gray-400">Riesgo (5%):</span>
            <span class="font-mono font-bold text-amber-400 text-sm" id="formCurrentRiskBudgetDisplay">$5.50</span>
          </div>
        </div>

        <form id="tradeForm" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-4 text-xs">
            
            <!-- Dirección (3 cols) -->
            <div class="lg:col-span-3">
              <label class="block text-gray-400 mb-1.5 font-semibold">Dirección</label>
              <div class="grid grid-cols-2 gap-1.5 bg-gray-950 p-1 rounded-xl border border-gray-800">
                <button type="button" id="btnDirBuy" class="py-2.5 rounded-lg text-center font-bold text-xs bg-tvGreen text-white shadow transition flex items-center justify-center gap-1">
                  <i data-lucide="arrow-up-right" class="w-3.5 h-3.5"></i> BUY Larga
                </button>
                <button type="button" id="btnDirSell" class="py-2.5 rounded-lg text-center font-bold text-xs text-gray-400 hover:text-white transition flex items-center justify-center gap-1">
                  <i data-lucide="arrow-down-right" class="w-3.5 h-3.5"></i> SELL Corta
                </button>
              </div>
              <input type="hidden" id="tradeDirection" value="BUY">
            </div>

            <!-- Stop Loss Puntos (4 cols) -->
            <div class="lg:col-span-4">
              <div class="flex items-center justify-between mb-1.5">
                <label class="text-gray-300 font-bold flex items-center gap-1.5 text-xs">
                  <span>Stop Loss en Puntos (Oro)</span>
                  <span class="text-blue-400 text-[10px] font-normal" id="tvPointsExplain">Stop: 250 (2.50)</span>
                </label>
              </div>
              <div class="relative">
                <input type="number" id="tradeTvPoints" min="1" step="any" class="w-full bg-gray-950 border-2 border-blue-500/50 focus:border-blue-400 rounded-xl px-3.5 py-2 text-white font-mono font-black text-base focus:outline-none" value="250" placeholder="ej. 250 o 2.50">
                <span class="absolute right-3 top-2.5 text-xs text-gray-400 font-bold uppercase">pts oro</span>
              </div>
              
              <!-- Quick buttons for TradingView points -->
              <div class="flex flex-wrap items-center gap-1 mt-2">
                <span class="text-[10px] text-gray-500">Rápidos:</span>
                <button type="button" class="btnQuickTv px-1.5 py-0.5 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded text-[10px] font-mono" data-val="150">150</button>
                <button type="button" class="btnQuickTv px-1.5 py-0.5 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded text-[10px] font-mono" data-val="200">200</button>
                <button type="button" class="btnQuickTv px-1.5 py-0.5 bg-blue-500/20 text-blue-400 border border-blue-500/40 rounded text-[10px] font-mono font-bold" data-val="250">250</button>
                <button type="button" class="btnQuickTv px-1.5 py-0.5 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded text-[10px] font-mono" data-val="300">300</button>
                <button type="button" class="btnQuickTv px-1.5 py-0.5 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded text-[10px] font-mono" data-val="350">350</button>
                <button type="button" id="btnUseAvgSl" class="px-1.5 py-0.5 bg-indigo-950/70 hover:bg-indigo-900/90 text-indigo-300 border border-indigo-700/60 rounded text-[10px] font-mono font-bold flex items-center gap-1" title="Usar el Stop Loss promedio registrado">
                  <i data-lucide="crosshair" class="w-3 h-3 text-indigo-400"></i>
                  <span>Promedio: <strong id="labelFormAvgSl">250</strong> pts</span>
                </button>
              </div>
            </div>

            <!-- R:R de este Trade (2 cols) -->
            <div class="lg:col-span-2">
              <div class="flex items-center justify-between mb-1.5">
                <label class="text-gray-400 font-semibold">R:R de este Trade</label>
              </div>
              <div class="relative">
                <span class="absolute left-2.5 top-2 text-xs text-gray-500 font-bold">1:</span>
                <input type="number" id="tradeSpecificRR" step="0.1" min="0.5" max="10" class="w-full bg-gray-950 border border-gray-800 rounded-xl pl-6 pr-2 py-2 text-blue-400 font-mono font-bold text-sm focus:border-blue-500 focus:outline-none" value="1.0">
              </div>
              <span class="text-[10px] text-gray-500 block mt-1.5">Ratio objetivo</span>
            </div>

            <!-- Fecha (3 cols) -->
            <div class="lg:col-span-3">
              <label class="block text-gray-400 mb-1.5 font-semibold">Fecha y Hora</label>
              <input type="text" id="tradeDate" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-white font-mono focus:border-gold-500 focus:outline-none" placeholder="YYYY-MM-DD HH:MM">
            </div>

          </div>

          <!-- Position Summary Bar -->
          <div class="rounded-xl border border-gray-800 overflow-hidden font-mono text-xs shadow-xl">
            <!-- TP Target Bar (Green) -->
            <div class="bg-tvGreen/20 border-b border-tvGreen/30 px-4 py-2 flex items-center justify-between text-tvGreen">
              <div class="flex items-center gap-2">
                <span class="font-bold uppercase tracking-wider text-[11px]">Objetivo Take Profit</span>
                <span class="text-white font-bold" id="tvWidgetTpPoints">250 (2.50)</span>
              </div>
              <div class="font-bold text-emerald-400" id="tvWidgetRewardUsd">
                +$5.50 (+5.0%)
              </div>
            </div>

            <!-- Center Status Bar -->
            <div class="bg-gray-950 px-4 py-2.5 flex flex-wrap items-center justify-between gap-4 text-xs">
              <div class="flex items-center gap-4">
                <div>
                  <span class="text-gray-400 text-[10px] block uppercase">Relación R:R</span>
                  <span class="text-blue-400 font-bold text-sm" id="tvWidgetRRRatio">1:1.0</span>
                </div>
                <div class="h-6 w-px bg-gray-800"></div>
                <div>
                  <span class="text-gray-400 text-[10px] block uppercase">Lote Sugerido MT4/MT5</span>
                  <div class="flex items-baseline gap-1.5">
                    <span class="text-gold-400 font-black text-lg" id="calcOutLot">0.02</span>
                    <span class="text-[10px] text-gray-500" id="tvRawLotText">(raw: 0.0220)</span>
                  </div>
                </div>
                <div class="h-6 w-px bg-gray-800"></div>
                <div>
                  <span class="text-gray-400 text-[10px] block uppercase">Margen a 1:300</span>
                  <span class="text-purple-300 font-bold" id="calcOutMargin">~$18.00 (16.4%)</span>
                </div>
              </div>

              <!-- Warning Box -->
              <div id="calcWarningBox" class="hidden text-[11px] px-3 py-1.5 rounded-lg bg-amber-950/60 border border-amber-800/80 text-amber-200 flex items-center gap-2">
                <i data-lucide="alert-triangle" class="w-3.5 h-3.5 text-amber-400 shrink-0"></i>
                <span id="calcWarningText">Aviso</span>
              </div>
            </div>

            <!-- SL Stop Bar (Red) -->
            <div class="bg-tvRed/20 border-t border-tvRed/30 px-4 py-2 flex items-center justify-between text-tvRed">
              <div class="flex items-center gap-2">
                <span class="font-bold uppercase tracking-wider text-[11px]">Nivel de Stop Loss</span>
                <span class="text-white font-bold" id="tvWidgetSlPoints">250 (2.50)</span>
              </div>
              <div class="font-bold text-rose-400" id="tvWidgetRiskUsd">
                -$5.50 (-5.0%)
              </div>
            </div>

            <input type="hidden" id="tradeLot" value="0.02">
          </div>

          <!-- Outcome Selector & Optional Setup/Notes -->
          <div class="grid grid-cols-1 md:grid-cols-12 gap-3.5 pt-1">
            
            <!-- Resultado (6 cols) -->
            <div class="md:col-span-6 space-y-1.5">
              <label class="block text-xs font-semibold text-gray-300">Resultado de la Operación</label>
              <div class="grid grid-cols-3 gap-2">
                <label class="relative flex flex-col items-center justify-center p-2.5 rounded-xl border border-gray-800 bg-gray-950 cursor-pointer hover:border-tvGreen transition has-[:checked]:border-tvGreen has-[:checked]:bg-emerald-950/40">
                  <input type="radio" name="tradeResult" value="win" checked class="hidden">
                  <span class="text-xs font-bold text-emerald-400 flex items-center gap-1">
                    <i data-lucide="check-circle" class="w-3.5 h-3.5"></i> GANADA (TP)
                  </span>
                  <span class="text-[10px] text-emerald-400/80 font-mono mt-0.5" id="formPreviewGain">+$5.50</span>
                </label>

                <label class="relative flex flex-col items-center justify-center p-2.5 rounded-xl border border-gray-800 bg-gray-950 cursor-pointer hover:border-tvRed transition has-[:checked]:border-tvRed has-[:checked]:bg-rose-950/40">
                  <input type="radio" name="tradeResult" value="loss" class="hidden">
                  <span class="text-xs font-bold text-rose-400 flex items-center gap-1">
                    <i data-lucide="x-circle" class="w-3.5 h-3.5"></i> PERDIDA (SL)
                  </span>
                  <span class="text-[10px] text-rose-400/80 font-mono mt-0.5" id="formPreviewLoss">-$5.50</span>
                </label>

                <label class="relative flex flex-col items-center justify-center p-2.5 rounded-xl border border-gray-800 bg-gray-950 cursor-pointer hover:border-gray-500 transition has-[:checked]:border-gray-500 has-[:checked]:bg-gray-800/60">
                  <input type="radio" name="tradeResult" value="be" class="hidden">
                  <span class="text-xs font-bold text-gray-300 flex items-center gap-1">
                    <i data-lucide="minus-circle" class="w-3.5 h-3.5"></i> BREAKEVEN
                  </span>
                  <span class="text-[10px] text-gray-400 font-mono mt-0.5">$0.00</span>
                </label>
              </div>
            </div>

            <!-- Estrategia (3 cols) -->
            <div class="md:col-span-3">
              <label class="block text-xs font-semibold text-gray-300 mb-1.5">Estrategia / Setup</label>
              <input type="text" id="tradeStrategy" placeholder="ej. Order Block, FVG, Ruptura" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-xs text-white focus:border-gold-500 focus:outline-none" value="Ruptura de Rango">
            </div>

            <!-- Notas (3 cols) -->
            <div class="md:col-span-3">
              <label class="block text-xs font-semibold text-gray-300 mb-1.5">Notas</label>
              <input type="text" id="tradeNotes" placeholder="ej. Sesión Londres, pullback limpio" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-xs text-white focus:border-gold-500 focus:outline-none">
            </div>

          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <button type="submit" id="btnSubmitTrade" class="w-full py-3 bg-gradient-to-r from-blue-600 via-indigo-600 to-tvBlue hover:from-blue-500 hover:to-indigo-500 text-white font-bold text-sm rounded-xl shadow-lg shadow-blue-900/30 transition flex items-center justify-center gap-2">
              <i data-lucide="plus-circle" class="w-4 h-4"></i>
              <span>REGISTRAR OPERACIÓN AL BACKTEST</span>
            </button>
          </div>

        </form>
      </section>

      <!-- Charts Section: Equity Curve & Outcomes -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Equity Growth Curve (8 cols) -->
        <div class="lg:col-span-8 bg-cardBg border border-cardBorder rounded-2xl p-5 shadow-xl">
          <div class="flex items-center justify-between mb-4">
            <div>
              <h3 class="text-sm font-bold text-white flex items-center gap-2">
                <i data-lucide="trending-up" class="w-4 h-4 text-emerald-400"></i>
                <span>Curva de Capital Compuesta (Backtesting Dinámico)</span>
              </h3>
              <p class="text-[11px] text-gray-400">Cálculo porcentual puro recalculado en vivo con tu riesgo % y R:R activo</p>
            </div>
            <div class="flex items-center gap-3 text-xs">
              <span class="flex items-center gap-1 text-emerald-400 font-medium">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span> Balance ($)
              </span>
              <span class="flex items-center gap-1 text-gray-500 font-medium">
                <span class="w-2.5 h-0.5 bg-gray-500"></span> Base Inicial
              </span>
            </div>
          </div>
          <div class="h-64 w-full relative">
            <canvas id="equityChart"></canvas>
          </div>
        </div>

        <!-- Outcomes Donut + Mini Drawdown (4 cols) -->
        <div class="lg:col-span-4 bg-cardBg border border-cardBorder rounded-2xl p-5 shadow-xl flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-sm font-bold text-white flex items-center gap-2">
                <i data-lucide="pie-chart" class="w-4 h-4 text-gold-400"></i>
                <span>Distribución de Trades</span>
              </h3>
              <span class="text-[10px] text-gray-400" id="donutTotalCount">0 trades</span>
            </div>
            <div class="h-40 w-full relative flex items-center justify-center">
              <canvas id="distributionChart"></canvas>
            </div>
          </div>

          <div class="border-t border-gray-800 pt-3 mt-3">
            <div class="flex items-center justify-between text-xs mb-1">
              <span class="text-gray-400 font-medium">Drawdown Histórico (%)</span>
              <span class="text-rose-400 font-mono text-[11px]" id="currentDrawdownDisplay">0.0%</span>
            </div>
            <div class="h-16 w-full relative">
              <canvas id="drawdownChart"></canvas>
            </div>
          </div>
        </div>

      </section>

      <!-- Historical Trades Table (Backtest) -->
      <section class="bg-cardBg border border-cardBorder rounded-2xl p-5 shadow-xl space-y-4">
        
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-800 pb-3">
          <div>
            <h3 class="text-sm font-bold text-white flex items-center gap-2">
              <i data-lucide="list-ordered" class="w-4 h-4 text-gold-400"></i>
              <span>Historial de Operaciones de Backtesting</span>
            </h3>
            <p class="text-[11px] text-gray-400">Interés compuesto puro en base al % de riesgo, sin distorsión por redondeo de lotes</p>
          </div>

          <!-- Filter & CSV Export -->
          <div class="flex items-center gap-2 text-xs">
            <div class="flex bg-gray-950 p-0.5 rounded-lg border border-gray-800">
              <button id="filterAll" class="px-2.5 py-1 rounded text-white font-semibold bg-gray-800">Todas (<span id="countAll">0</span>)</button>
              <button id="filterWins" class="px-2.5 py-1 rounded text-gray-400 hover:text-emerald-400">Wins (<span id="countWins">0</span>)</button>
              <button id="filterLosses" class="px-2.5 py-1 rounded text-gray-400 hover:text-rose-400">Losses (<span id="countLosses">0</span>)</button>
            </div>
            <button id="btnExportCsv" class="px-3 py-1.5 bg-gray-800 hover:bg-gray-700 rounded-lg border border-gray-700 text-gray-300 font-medium transition flex items-center gap-1.5" title="Exportar a CSV">
              <i data-lucide="download" class="w-3.5 h-3.5"></i>
              <span>Exportar CSV</span>
            </button>
          </div>
        </div>

        <!-- Table Container -->
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-gray-300">
            <thead class="bg-gray-950/70 uppercase text-[10px] text-gray-400 tracking-wider">
              <tr>
                <th class="py-2.5 px-3">#</th>
                <th class="py-2.5 px-3">Fecha</th>
                <th class="py-2.5 px-3">Tipo</th>
                <th class="py-2.5 px-3">Stop Loss</th>
                <th class="py-2.5 px-3">Take Profit</th>
                <th class="py-2.5 px-3">Ratio R:R</th>
                <th class="py-2.5 px-3">Riesgo ($)</th>
                <th class="py-2.5 px-3">Lote Sug. MT4</th>
                <th class="py-2.5 px-3">Margen (1:300)</th>
                <th class="py-2.5 px-3">Resultado</th>
                <th class="py-2.5 px-3">PnL ($)</th>
                <th class="py-2.5 px-3">Balance Compuesto</th>
                <th class="py-2.5 px-3">Estrategia</th>
                <th class="py-2.5 px-3 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody id="tradesTableBody" class="divide-y divide-gray-800/60 font-mono">
              <tr>
                <td colspan="14" class="py-12 text-center text-gray-500 font-sans">
                  Cargando operaciones de backtesting...
                </td>
              </tr>
            </tbody>
          </table>
        </div>

      </section>

    </div>


    <!-- ============================================================== -->
    <!-- VIEW 2: BITÁCORA REAL (Live Operations Journal & Psychology)  -->
    <!-- ============================================================== -->
    <div id="viewRealJournal" class="hidden space-y-6">
      
      <!-- Top Banner Real Journal -->
      <section class="bg-gradient-to-r from-emerald-950/40 via-gray-900 to-teal-950/40 border-2 border-emerald-500/40 rounded-2xl p-4 sm:p-5 shadow-2xl flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="p-2.5 bg-emerald-500/20 text-emerald-400 rounded-xl border border-emerald-500/30">
            <i data-lucide="book-open" class="w-6 h-6"></i>
          </div>
          <div>
            <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
              <span>Bitácora Real de Operaciones en Vivo</span>
              <span class="text-xs bg-emerald-950 text-emerald-400 border border-emerald-800 px-2 py-0.5 rounded-full font-mono">Forward-Testing</span>
            </h2>
            <p class="text-xs text-gray-400">Registra tus trades diarios en cuenta real/demo con sesión, link a TradingView y análisis emocional de disciplina</p>
          </div>
        </div>

        <div class="flex items-center gap-3 text-xs">
          <div class="bg-gray-950/80 border border-gray-800 px-3 py-1.5 rounded-xl flex items-center gap-2">
            <span class="text-gray-400">Total Operaciones Reales:</span>
            <span class="font-bold text-white font-mono text-sm" id="realStatTotalOps">0</span>
          </div>
          <button id="btnSyncRealBalance" class="px-3 py-1.5 bg-emerald-950/60 hover:bg-emerald-900/80 text-emerald-300 border border-emerald-800/80 rounded-xl font-semibold flex items-center gap-1.5 transition" title="Actualizar estadísticas">
            <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
            <span>Actualizar</span>
          </button>
        </div>
      </section>

      <!-- KPI Summary Cards (Real Journal) -->
      <section class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3.5">
        
        <!-- Card 1: Balance Real Actual -->
        <div class="bg-cardBg border border-cardBorder rounded-xl p-4 flex flex-col justify-between">
          <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">Balance Real</span>
          <div class="mt-2">
            <div class="text-2xl font-black text-white" id="realStatBalance">$110.00</div>
            <div class="text-[11px] mt-1 text-gray-400">
              PnL Neto: <span id="realStatNetPnL" class="font-bold text-emerald-400">+$0.00 (+0.0%)</span>
            </div>
          </div>
          <div class="text-[10px] text-gray-500 mt-2">Capital inicial: $<span id="realStatInitBal">110.00</span></div>
        </div>

        <!-- Card 2: Win Rate Real -->
        <div class="bg-cardBg border border-cardBorder rounded-xl p-4 flex flex-col justify-between">
          <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">Win Rate Real</span>
          <div class="mt-2">
            <div class="text-2xl font-black text-white" id="realStatWinRate">0.0%</div>
            <div class="text-[11px] text-gray-400 flex items-center justify-between mt-1">
              <span><strong id="realStatWins" class="text-emerald-400">0</strong> Wins</span>
              <span><strong id="realStatLosses" class="text-rose-400">0</strong> Losses</span>
            </div>
          </div>
          <div class="w-full bg-gray-800 h-1.5 rounded-full mt-2 overflow-hidden">
            <div id="realStatWinRateBar" class="bg-emerald-400 h-full rounded-full transition-all duration-500" style="width: 0%"></div>
          </div>
        </div>

        <!-- Card 3: Profit Factor Real -->
        <div class="bg-cardBg border border-cardBorder rounded-xl p-4 flex flex-col justify-between">
          <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">Profit Factor</span>
          <div class="mt-2">
            <div class="text-2xl font-black text-white" id="realStatPF">0.00</div>
            <div class="text-[11px] text-gray-400 mt-1 flex justify-between">
              <span class="text-emerald-400">+$<span id="realStatGain">0.00</span></span>
              <span class="text-rose-400">-$<span id="realStatLoss">0.00</span></span>
            </div>
          </div>
          <div class="text-[10px] text-gray-500 mt-2">Relación ganancia / pérdida</div>
        </div>

        <!-- Card 4: Índice de Disciplina -->
        <div class="bg-cardBg border border-cardBorder rounded-xl p-4 flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">Disciplina</span>
            <i data-lucide="brain" class="w-3.5 h-3.5 text-emerald-400"></i>
          </div>
          <div class="mt-2">
            <div class="text-2xl font-black text-emerald-400" id="realStatDisciplinePct">100%</div>
            <div class="text-[11px] text-gray-400 mt-1">
              Plan cumplido: <span id="realStatDisciplineCount" class="font-bold text-white">0/0</span>
            </div>
          </div>
          <div class="text-[10px] text-gray-500 mt-2">Psicotrading bajo control</div>
        </div>

        <!-- Card 5: SL Promedio Real -->
        <div class="bg-cardBg border border-cardBorder rounded-xl p-4 flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">SL Promedio</span>
            <i data-lucide="crosshair" class="w-3.5 h-3.5 text-blue-400"></i>
          </div>
          <div class="mt-2">
            <div class="text-2xl font-black text-white flex items-baseline gap-1">
              <span id="realStatAvgSl">0</span>
              <span class="text-xs text-blue-400 font-mono">pts</span>
            </div>
            <div class="text-[11px] text-gray-400 mt-1">
              Distancia: $<span id="realStatAvgSlPrice" class="font-semibold text-gray-300">0.00</span>
            </div>
          </div>
          <div class="text-[10px] text-gray-500 mt-2">Control de volatilidad</div>
        </div>

        <!-- Card 6: Max Drawdown Real -->
        <div class="bg-cardBg border border-cardBorder rounded-xl p-4 flex flex-col justify-between">
          <div class="flex items-center justify-between">
            <span class="text-xs font-medium text-gray-400 uppercase tracking-wider">Max Drawdown</span>
            <i data-lucide="trending-down" class="w-3.5 h-3.5 text-rose-500"></i>
          </div>
          <div class="mt-2">
            <div class="text-2xl font-black text-rose-400" id="realStatDD">0.0%</div>
            <div class="text-[11px] text-gray-400 mt-1">
              Caída máx: <span id="realStatDDUsd" class="font-semibold text-gray-300">-$0.00</span>
            </div>
          </div>
          <div class="text-[10px] text-gray-500 mt-2">Preservación de capital</div>
        </div>

      </section>

      <!-- REGISTRAR OPERACIÓN EN BITÁCORA REAL -->
      <section class="bg-gradient-to-b from-gray-900 to-cardBg border border-cardBorder rounded-2xl p-5 sm:p-6 shadow-2xl space-y-4">
        
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-800 pb-4">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
              <i data-lucide="plus-circle" class="w-5 h-5"></i>
            </div>
            <div>
              <h2 class="text-base font-bold text-white flex items-center gap-2">
                <span>Registrar Trade en Bitácora Real</span>
              </h2>
              <p class="text-xs text-gray-400">Solo puntos de SL en el oro y % de riesgo — sin precios de entrada ni salida</p>
            </div>
          </div>

          <div class="flex items-center gap-2 text-xs bg-emerald-950/50 border border-emerald-800/50 px-3 py-1.5 rounded-xl">
            <span class="text-gray-400">Balance actual:</span>
            <span class="font-mono font-bold text-emerald-400 text-sm" id="realFormCurrentBalDisplay">$110.00</span>
          </div>
        </div>

        <form id="realTradeForm" class="space-y-4">
          
          <!-- Row 1: Date, Session, Direction, SL Points, Risk %, RR -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-3.5 text-xs">
            
            <!-- Fecha y Hora (3 cols) -->
            <div class="lg:col-span-3">
              <label class="block text-gray-400 mb-1.5 font-semibold">Fecha y Hora</label>
              <input type="text" id="realTradeDate" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-white font-mono focus:border-emerald-500 focus:outline-none" placeholder="YYYY-MM-DD HH:MM">
            </div>

            <!-- Sesión de Trading (2 cols) -->
            <div class="lg:col-span-2">
              <label class="block text-gray-400 mb-1.5 font-semibold">Sesión</label>
              <select id="realTradeSession" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-white font-semibold focus:border-emerald-500 focus:outline-none">
                <option value="New York" selected>🇺🇸 New York</option>
                <option value="London">🇬🇧 Londres</option>
                <option value="Asia">🇯🇵 Asia / Tokio</option>
                <option value="London/NY Overlap">⚡ Solapamiento</option>
                <option value="Pre-Market">🌅 Pre-Market</option>
              </select>
            </div>

            <!-- Dirección (2 cols) -->
            <div class="lg:col-span-2">
              <label class="block text-gray-400 mb-1.5 font-semibold">Dirección</label>
              <div class="grid grid-cols-2 gap-1 bg-gray-950 p-1 rounded-xl border border-gray-800">
                <button type="button" id="btnRealDirBuy" class="py-1.5 rounded-lg text-center font-bold text-xs bg-tvGreen text-white shadow transition flex items-center justify-center">BUY</button>
                <button type="button" id="btnRealDirSell" class="py-1.5 rounded-lg text-center font-bold text-xs text-gray-400 hover:text-white transition flex items-center justify-center">SELL</button>
              </div>
              <input type="hidden" id="realTradeDirection" value="BUY">
            </div>

            <!-- Stop Loss Puntos Oro (3 cols) -->
            <div class="lg:col-span-3">
              <div class="flex items-center justify-between mb-1.5">
                <label class="text-gray-300 font-bold">Stop Loss (Puntos Oro)</label>
                <span class="text-emerald-400 text-[10px]" id="realSlExplain">250 ($2.50)</span>
              </div>
              <div class="relative">
                <input type="number" id="realTradeTvPoints" min="1" step="any" class="w-full bg-gray-950 border-2 border-emerald-500/50 focus:border-emerald-400 rounded-xl px-3.5 py-1.5 text-white font-mono font-black text-base focus:outline-none" value="250" placeholder="250">
                <span class="absolute right-3 top-2 text-xs text-gray-400 font-bold uppercase">pts</span>
              </div>
            </div>

            <!-- Riesgo % & RR (2 cols) -->
            <div class="lg:col-span-2 grid grid-cols-2 gap-2">
              <div>
                <label class="block text-gray-400 mb-1.5 font-semibold">Riesgo %</label>
                <input type="number" id="realTradeRiskPct" step="0.1" min="0.5" max="20" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-2 py-2 text-amber-400 font-mono font-bold text-center focus:border-emerald-500 focus:outline-none" value="5.0">
              </div>
              <div>
                <label class="block text-gray-400 mb-1.5 font-semibold">R:R</label>
                <input type="number" id="realTradeRR" step="0.1" min="0.5" max="10" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-2 py-2 text-blue-400 font-mono font-bold text-center focus:border-emerald-500 focus:outline-none" value="1.0">
              </div>
            </div>

          </div>

          <!-- Row 2: Setup, Psychology / Emotion, TV Chart Link -->
          <div class="grid grid-cols-1 md:grid-cols-12 gap-3.5 text-xs">
            
            <!-- Setup / Estrategia (4 cols) -->
            <div class="md:col-span-4">
              <label class="block text-gray-400 mb-1.5 font-semibold">Estrategia / Setup Técnico</label>
              <select id="realTradeStrategy" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-white focus:border-emerald-500 focus:outline-none">
                <option value="Order Block (OB)">📦 Order Block (OB)</option>
                <option value="Fair Value Gap (FVG)">🕳️ Fair Value Gap (FVG)</option>
                <option value="Ruptura de Rango NY" selected>💥 Ruptura de Rango NY</option>
                <option value="Cambio de Estructura (CHoCH)">🔄 Cambio de Estructura (CHoCH)</option>
                <option value="Pullback EMA 50/200">📈 Pullback EMA 50/200</option>
                <option value="Liquidez / Barrida (Sweep)">🧹 Liquidez / Barrida (Sweep)</option>
              </select>
            </div>

            <!-- Psicotrading & Disciplina (4 cols) -->
            <div class="md:col-span-4">
              <label class="block text-gray-400 mb-1.5 font-semibold flex items-center gap-1.5">
                <i data-lucide="brain" class="w-3.5 h-3.5 text-emerald-400"></i>
                <span>Disciplina & Psicotrading</span>
              </label>
              <select id="realTradeEmotion" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-white font-semibold focus:border-emerald-500 focus:outline-none">
                <option value="Plan Seguido 100%" class="text-emerald-400">🟢 Plan Seguido 100% (Disciplina impecable)</option>
                <option value="Paciente (Confirmación)" class="text-emerald-400">🟢 Paciente (Esperó confirmación)</option>
                <option value="Entrada Anticipada" class="text-amber-400">🟡 Entrada Anticipada (Ansiedad)</option>
                <option value="Salida Prematura" class="text-amber-400">🟡 Salida Prematura (Miedo a perder)</option>
                <option value="FOMO" class="text-rose-400">🔴 FOMO (Persecución del precio)</option>
                <option value="Operativa por Venganza" class="text-rose-400">🔴 Revancha (Recuperar pérdida)</option>
              </select>
            </div>

            <!-- TradingView Chart URL (4 cols) -->
            <div class="md:col-span-4">
              <label class="block text-gray-400 mb-1.5 font-semibold flex items-center gap-1.5">
                <i data-lucide="link" class="w-3.5 h-3.5 text-blue-400"></i>
                <span>URL Captura TradingView (Opcional)</span>
              </label>
              <input type="url" id="realTradeChartUrl" placeholder="https://www.tradingview.com/x/..." class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-xs text-white focus:border-emerald-500 focus:outline-none">
            </div>

          </div>

          <!-- Live Preview Strip (Myfxbook lot & projected $ risk) -->
          <div class="bg-gray-950 p-3 rounded-xl border border-gray-800 flex flex-wrap items-center justify-between gap-4 font-mono text-xs">
            <div class="flex items-center gap-3">
              <span class="text-gray-400">Riesgo en $:</span>
              <span class="font-bold text-rose-400 text-sm" id="realPreviewRiskDollar">-$5.50 (-5.0%)</span>
              <span class="text-gray-600">|</span>
              <span class="text-gray-400">Ganancia Potencial:</span>
              <span class="font-bold text-emerald-400 text-sm" id="realPreviewRewardDollar">+$5.50 (+5.0%)</span>
            </div>

            <div class="flex items-center gap-3">
              <span class="text-gray-400">Lote Sugerido MT4:</span>
              <span class="font-black text-gold-400 text-sm px-2 py-0.5 rounded bg-gold-500/10 border border-gold-500/30" id="realPreviewLot">0.02</span>
              <span class="text-gray-600">|</span>
              <span class="text-gray-400">Margen (1:300):</span>
              <span class="font-bold text-purple-300" id="realPreviewMargin">~$18.00</span>
            </div>
          </div>

          <!-- Outcome Selector & Submit -->
          <div class="grid grid-cols-1 md:grid-cols-12 gap-3.5 items-center pt-1">
            <div class="md:col-span-7">
              <div class="grid grid-cols-3 gap-2">
                <label class="relative flex flex-col items-center justify-center p-2 rounded-xl border border-gray-800 bg-gray-950 cursor-pointer hover:border-tvGreen transition has-[:checked]:border-tvGreen has-[:checked]:bg-emerald-950/40">
                  <input type="radio" name="realTradeResult" value="win" checked class="hidden">
                  <span class="text-xs font-bold text-emerald-400 flex items-center gap-1">
                    <i data-lucide="check-circle" class="w-3.5 h-3.5"></i> GANADA (TP)
                  </span>
                </label>

                <label class="relative flex flex-col items-center justify-center p-2 rounded-xl border border-gray-800 bg-gray-950 cursor-pointer hover:border-tvRed transition has-[:checked]:border-tvRed has-[:checked]:bg-rose-950/40">
                  <input type="radio" name="realTradeResult" value="loss" class="hidden">
                  <span class="text-xs font-bold text-rose-400 flex items-center gap-1">
                    <i data-lucide="x-circle" class="w-3.5 h-3.5"></i> PERDIDA (SL)
                  </span>
                </label>

                <label class="relative flex flex-col items-center justify-center p-2 rounded-xl border border-gray-800 bg-gray-950 cursor-pointer hover:border-gray-500 transition has-[:checked]:border-gray-500 has-[:checked]:bg-gray-800/60">
                  <input type="radio" name="realTradeResult" value="be" class="hidden">
                  <span class="text-xs font-bold text-gray-300 flex items-center gap-1">
                    <i data-lucide="minus-circle" class="w-3.5 h-3.5"></i> BREAKEVEN
                  </span>
                </label>
              </div>
            </div>

            <div class="md:col-span-5">
              <button type="submit" id="btnSubmitRealTrade" class="w-full py-3 bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-500 hover:from-emerald-500 hover:to-teal-400 text-white font-bold text-sm rounded-xl shadow-lg shadow-emerald-900/30 transition flex items-center justify-center gap-2">
                <i data-lucide="save" class="w-4 h-4"></i>
                <span>REGISTRAR EN BITÁCORA REAL</span>
              </button>
            </div>
          </div>

        </form>
      </section>

      <!-- Tabla de Operaciones Reales -->
      <section class="bg-cardBg border border-cardBorder rounded-2xl p-5 shadow-xl space-y-4">
        
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-800 pb-3">
          <div>
            <h3 class="text-sm font-bold text-white flex items-center gap-2">
              <i data-lucide="book-marked" class="w-4 h-4 text-emerald-400"></i>
              <span>Registro de Operaciones Reales</span>
            </h3>
            <p class="text-[11px] text-gray-400">Historial de ejecuciones reales con notas de psicología, estrategia y enlace a TradingView</p>
          </div>

          <div class="flex items-center gap-2 text-xs">
            <button id="btnExportRealCsv" class="px-3 py-1.5 bg-gray-800 hover:bg-gray-700 rounded-lg border border-gray-700 text-gray-300 font-medium transition flex items-center gap-1.5" title="Exportar Bitácora">
              <i data-lucide="download" class="w-3.5 h-3.5"></i>
              <span>Exportar Bitácora CSV</span>
            </button>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-gray-300">
            <thead class="bg-gray-950/70 uppercase text-[10px] text-gray-400 tracking-wider">
              <tr>
                <th class="py-2.5 px-3">#</th>
                <th class="py-2.5 px-3">Fecha</th>
                <th class="py-2.5 px-3">Sesión</th>
                <th class="py-2.5 px-3">Tipo</th>
                <th class="py-2.5 px-3">Stop Loss</th>
                <th class="py-2.5 px-3">Ratio R:R</th>
                <th class="py-2.5 px-3">Riesgo ($)</th>
                <th class="py-2.5 px-3">Lote MT4</th>
                <th class="py-2.5 px-3">Resultado</th>
                <th class="py-2.5 px-3">PnL ($)</th>
                <th class="py-2.5 px-3">Balance</th>
                <th class="py-2.5 px-3">Estrategia</th>
                <th class="py-2.5 px-3">Disciplina / Emoción</th>
                <th class="py-2.5 px-3">Gráfico TV</th>
                <th class="py-2.5 px-3 text-right">Acciones</th>
              </tr>
            </thead>
            <tbody id="realTradesTableBody" class="divide-y divide-gray-800/60 font-mono">
              <tr>
                <td colspan="15" class="py-12 text-center text-gray-500 font-sans">
                  Aún no has registrado operaciones en tu Bitácora Real. Llena el formulario superior para documentar tu primera operación.
                </td>
              </tr>
            </tbody>
          </table>
        </div>

      </section>

    </div>


    <!-- ============================================================== -->
    <!-- VIEW 3: CALCULADORA MYFXBOOK (Oro XAU/USD en Puntos)          -->
    <!-- ============================================================== -->
    <div id="viewCalculator" class="hidden space-y-6">
      
      <!-- Banner / Title -->
      <section class="bg-gradient-to-r from-amber-950/40 via-gray-900 to-yellow-950/40 border-2 border-gold-500/40 rounded-2xl p-4 sm:p-5 shadow-2xl flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="p-2.5 bg-gold-500/20 text-gold-400 rounded-xl border border-gold-500/30">
            <i data-lucide="calculator" class="w-6 h-6"></i>
          </div>
          <div>
            <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
              <span>Calculadora de Posición Estilo Myfxbook</span>
              <span class="text-xs bg-gold-500/20 text-gold-300 border border-gold-500/40 px-2 py-0.5 rounded-full font-mono font-bold">Oro (XAU/USD)</span>
            </h2>
            <p class="text-xs text-gray-400">Calcula el lote exacto de MetaTrader, margen y ganancia sin precios de entrada ni salida: solo <strong>puntos de SL</strong> y <strong>porcentaje de riesgo</strong></p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button id="btnSyncBalToCalc" class="px-3 py-1.5 bg-gray-800 hover:bg-gray-700 text-xs font-semibold rounded-xl border border-gray-700 text-gold-300 flex items-center gap-1.5 transition">
            <i data-lucide="wallet" class="w-3.5 h-3.5"></i>
            <span>Sincronizar Balance de Cuenta</span>
          </button>
        </div>
      </section>

      <!-- Calculator Main Grid: Inputs vs Results -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- Left: Inputs Column (5 cols) -->
        <div class="lg:col-span-5 bg-cardBg border border-cardBorder rounded-2xl p-5 sm:p-6 shadow-xl space-y-4">
          <div class="flex items-center justify-between border-b border-gray-800 pb-3">
            <h3 class="text-sm font-bold text-white flex items-center gap-2">
              <i data-lucide="sliders" class="w-4 h-4 text-gold-400"></i>
              <span>Parámetros de Entrada</span>
            </h3>
            <span class="text-[10px] text-gray-500 font-mono">1 Lote = 100 oz</span>
          </div>

          <div class="space-y-4 text-xs">
            
            <!-- Input 1: Balance de Cuenta -->
            <div class="space-y-1.5">
              <div class="flex items-center justify-between">
                <label class="font-bold text-gray-300">Balance de la Cuenta ($ USD)</label>
                <span class="font-mono text-emerald-400 font-bold" id="myfxBalLabel">$110.00</span>
              </div>
              <div class="relative">
                <span class="absolute left-3 top-2.5 text-gray-500 font-bold text-sm">$</span>
                <input type="number" id="calcBalInput" min="10" step="10" class="w-full bg-gray-950 border border-gray-800 rounded-xl pl-7 pr-3 py-2 text-white font-mono font-bold text-base focus:border-gold-500 focus:outline-none" value="110">
              </div>
              <!-- Quick Balances -->
              <div class="flex flex-wrap items-center gap-1">
                <button type="button" class="btnCalcQuickBal px-2 py-0.5 bg-gold-500/20 text-gold-300 border border-gold-500/40 rounded text-[11px] font-mono font-bold" data-val="110">$110</button>
                <button type="button" class="btnCalcQuickBal px-2 py-0.5 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded text-[11px] font-mono" data-val="500">$500</button>
                <button type="button" class="btnCalcQuickBal px-2 py-0.5 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded text-[11px] font-mono" data-val="1000">$1,000</button>
                <button type="button" class="btnCalcQuickBal px-2 py-0.5 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded text-[11px] font-mono" data-val="5000">$5,000</button>
                <button type="button" class="btnCalcQuickBal px-2 py-0.5 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded text-[11px] font-mono" data-val="10000">$10,000</button>
              </div>
            </div>

            <!-- Input 2: Porcentaje de Riesgo -->
            <div class="space-y-1.5">
              <div class="flex items-center justify-between">
                <label class="font-bold text-gray-300">Porcentaje de Riesgo (%)</label>
                <span class="font-mono text-amber-400 font-bold" id="myfxRiskLabel">5.0%</span>
              </div>
              <div class="relative">
                <input type="number" id="calcRiskPctInput" min="0.1" max="50" step="0.1" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-white font-mono font-bold text-base focus:border-gold-500 focus:outline-none" value="5.0">
                <span class="absolute right-3 top-2.5 text-gray-500 font-bold text-sm">%</span>
              </div>
              <!-- Quick Risk -->
              <div class="flex flex-wrap items-center gap-1">
                <button type="button" class="btnCalcQuickRisk px-2 py-0.5 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded text-[11px] font-mono" data-val="1.0">1%</button>
                <button type="button" class="btnCalcQuickRisk px-2 py-0.5 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded text-[11px] font-mono" data-val="2.0">2%</button>
                <button type="button" class="btnCalcQuickRisk px-2 py-0.5 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded text-[11px] font-mono" data-val="3.0">3%</button>
                <button type="button" class="btnCalcQuickRisk px-2 py-0.5 bg-gold-500/20 text-gold-300 border border-gold-500/40 rounded text-[11px] font-mono font-bold" data-val="5.0">5%</button>
                <button type="button" class="btnCalcQuickRisk px-2 py-0.5 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded text-[11px] font-mono" data-val="10.0">10%</button>
              </div>
            </div>

            <!-- Input 3: Stop Loss en Puntos de Oro -->
            <div class="space-y-1.5">
              <div class="flex items-center justify-between">
                <label class="font-bold text-gray-300">Stop Loss en Puntos (Oro)</label>
                <span class="font-mono text-blue-400 font-bold" id="myfxSlLabel">250 pts ($2.50)</span>
              </div>
              <div class="relative">
                <input type="number" id="calcSlPointsInput" min="1" step="any" class="w-full bg-gray-950 border-2 border-gold-500/50 focus:border-gold-400 rounded-xl px-3.5 py-2 text-white font-mono font-black text-lg focus:outline-none" value="250">
                <span class="absolute right-3 top-2.5 text-xs text-gray-400 font-bold uppercase">puntos</span>
              </div>
              <!-- Quick Points -->
              <div class="flex flex-wrap items-center gap-1">
                <button type="button" class="btnCalcQuickSl px-2 py-0.5 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded text-[11px] font-mono" data-val="150">150 ($1.50)</button>
                <button type="button" class="btnCalcQuickSl px-2 py-0.5 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded text-[11px] font-mono" data-val="200">200 ($2.00)</button>
                <button type="button" class="btnCalcQuickSl px-2 py-0.5 bg-gold-500/20 text-gold-300 border border-gold-500/40 rounded text-[11px] font-mono font-bold" data-val="250">250 ($2.50)</button>
                <button type="button" class="btnCalcQuickSl px-2 py-0.5 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded text-[11px] font-mono" data-val="300">300 ($3.00)</button>
                <button type="button" class="btnCalcQuickSl px-2 py-0.5 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded text-[11px] font-mono" data-val="350">350 ($3.50)</button>
                <button type="button" class="btnCalcQuickSl px-2 py-0.5 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded text-[11px] font-mono" data-val="500">500 ($5.00)</button>
              </div>
            </div>

            <!-- Input 4: Ratio R:R & Apalancamiento -->
            <div class="grid grid-cols-2 gap-3 pt-1">
              <div>
                <label class="block font-bold text-gray-300 mb-1">Ratio R:R</label>
                <div class="relative">
                  <span class="absolute left-2.5 top-2 text-gray-500 font-bold">1:</span>
                  <input type="number" id="calcRRInput" step="0.1" min="0.5" max="10" class="w-full bg-gray-950 border border-gray-800 rounded-xl pl-6 pr-2 py-2 text-white font-mono font-bold focus:border-gold-500 focus:outline-none" value="1.0">
                </div>
              </div>
              <div>
                <label class="block font-bold text-gray-300 mb-1">Apalancamiento</label>
                <select id="calcLeverageInput" class="w-full bg-gray-950 border border-gray-800 rounded-xl px-2 py-2 text-white font-semibold focus:border-gold-500 focus:outline-none">
                  <option value="100">1:100</option>
                  <option value="200">1:200</option>
                  <option value="300" selected>1:300</option>
                  <option value="500">1:500</option>
                  <option value="1000">1:1000</option>
                </select>
              </div>
            </div>

