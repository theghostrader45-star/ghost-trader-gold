      <section class="bg-gradient-to-r from-gray-950 via-gray-900 to-gray-950 border-2 border-emerald-500/40 rounded-2xl p-5 sm:p-6 shadow-2xl space-y-4">
        
        <!-- Header del Plan de Acción -->
